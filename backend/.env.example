# AgricultureCloud configuration template.
# Copy this file to ".env" and fill in real values. Never commit ".env".

# development | testing | production
FLASK_ENV=development

# Signs session cookies and CSRF tokens. Must be random and at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<replace-with-a-long-random-value>

# MongoDB connection string. The database name is taken from the path.
#   Local:  mongodb://127.0.0.1:27017/agriculture_db
#   Atlas:  mongodb+srv://<username>:<password>@<cluster-host>/agriculture_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/agriculture_db

# OpenWeatherMap API key (https://openweathermap.org/api). Optional: without it
# the weather lookup is disabled and users enter climate values by hand.
# (To try the lookup without a key, see scripts/dev_weather_stub.py.)
WEATHER_API_KEY=

# --- Optional settings -------------------------------------------------------
# Apply pending database migrations when the app starts (default: on in
# development, off in production, where you run scripts/migrate.py yourself).
# AUTO_MIGRATE=false

# Public URL of the site (the address users open in a browser); used to build
# password-reset links. Default: http://localhost:5173 (the React dev server).
# APP_BASE_URL=https://agriculture.example.org

# Folder holding the compiled React app. When it exists the backend serves it,
# so one process hosts both the site and the API. Default: ../frontend/dist
# FRONTEND_DIST=/srv/agriculturecloud/frontend/dist

# Comma-separated host names this site is served from (production).
# ALLOWED_HOSTS=agriculture.example.org

# Number of reverse proxies in front of the app (0 = none). Needed for correct
# client IP addresses behind nginx / a load balancer.
# TRUSTED_PROXY_COUNT=1

# Shared rate-limit store when running several workers, e.g. redis://localhost:6379
# RATELIMIT_STORAGE_URI=memory://

# Password reset emails: disabled | smtp | console (console is development only)
# MAIL_BACKEND=smtp
# MAIL_FROM=no-reply@agriculture.example.org
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Where database backups are written (default: ./backups)
# BACKUP_DIR=/var/backups/agriculturecloud

# LOG_LEVEL=INFO
