{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open AgricultureCloud (React dev server)",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend/src"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Run backend (Flask API)",
            "program": "${workspaceFolder}/backend/run.py",
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            "console": "integratedTerminal"
        }
    ]
}
